# Адрес сайта для canonical, Open Graph и sitemap.
NEXT_PUBLIC_SITE_URL=https://pardailab.ru

# Необязательный внешний API. Если задан, его записи заменяют архив с тем же slug.
# PARDAILABS_API_URL=https://example.com

# Редакция: /admin
ADMIN_USER=editor
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Файл SQLite. На сервере укажите путь на постоянном диске.
# PARDAILABS_DB_PATH=data/pardailabs.db
